# Sovereign Workbench configuration

APP_ENV=development

# REQUIRED MODEL PROFILE SWITCH
# false = small/runnable profile
# true  = high-capability local profile
USE_HIGH_LEVEL_MODELS=false

# Sovereignty
SOVEREIGN_MODE=true
ALLOW_EXTERNAL_NETWORK=false
ALLOW_CLOUD_MODELS=false
ALLOW_REMOTE_TELEMETRY=false

# Local model runtime
MODEL_RUNTIME=vllm
MODEL_BASE_URL=http://127.0.0.1:8000/v1
MODEL_API_KEY=local-only

# Hardware
GPU_MEMORY_UTILIZATION=0.80
MAX_CONTEXT_TOKENS=16384

# Agent
MAX_AGENT_STEPS=20
MAX_RETRIES=2

# RAG
RAG_ENABLED=true
QDRANT_URL=http://127.0.0.1:6333

# OCR
OCR_ENABLED=true

# Sandbox
SANDBOX_ENABLED=true
SANDBOX_NETWORK=none
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_MB=2048
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_OUTPUT_LIMIT_KB=512

# Persistence
DATABASE_URL=postgresql://localhost/sovereign_ai

# Storage
DATA_ROOT=./data
ATTACHMENTS_ROOT=./data/attachments
KNOWLEDGE_ROOT=./data/knowledge
ARTIFACTS_ROOT=./data/artifacts
AUDIT_ROOT=./data/audit
